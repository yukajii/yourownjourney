# Cloudflare Pages caching rules.
#
# These replace the `headers` block in firebase.json, which Pages does not read.
# Getting this wrong is not cosmetic: a cached service worker pins installed
# users to an old build with no way to escape it.

# The service worker and the shell must be revalidated on every load.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate

# Everything under /assets carries a content hash in its filename, so it can
# be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
