# Copy to .env. Do not commit .env — it is gitignored.
#
# ONLY non-secret values belong in this file. Vite compiles every VITE_*
# variable into the JavaScript bundle, which is served to every visitor of
# leagues-2790f.web.app. A key placed here is a public key.

# Address of the reflection Worker. An address is not a secret.
VITE_REFLECTION_ENDPOINT=https://leagues-reflection.<your-subdomain>.workers.dev

# Cloudflare Web Analytics site token, from the Cloudflare dashboard under
# Analytics & Logs -> Web Analytics -> Add a site. Identifies the site, not an
# account, so it is safe in the bundle. Leave unset to collect nothing.
VITE_CF_ANALYTICS_TOKEN=

# The OpenAI key does NOT belong here. It lives on the Worker, set with:
#   cd worker && npx wrangler secret put OPENAI_API_KEY
# which stores it server-side, out of the repo and out of the bundle.
