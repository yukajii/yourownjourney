rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in person owns exactly one document, keyed by their uid.
    // Nothing else in the project is reachable from the client.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
